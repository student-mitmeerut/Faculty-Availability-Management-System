spring.application.name=FacultyAvailabilitySystem
spring.datasource.url=jdbc:mysql://localhost:3306/faculty_availability_db
spring.datasource.username=faculty_app
spring.datasource.password=${DB_PASSWORD}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false
server.port=8081
